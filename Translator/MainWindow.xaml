<Window x:Class="LavaTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="熔岩翻译助手"
        Height="580" Width="920"
        MinHeight="420" MinWidth="700"
        Icon="pack://application:,,,/icon.ico"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock x:Name="EngineLabel" Text="引擎: 百度翻译" Margin="0,0,16,0"/>
      </StatusBarItem>
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="Alt+Space · 准备就绪"/>
      </StatusBarItem>
    </StatusBar>

    <TabControl x:Name="MainTabs" Margin="12" SelectionChanged="OnMainTabChanged">
      <!-- 翻译 -->
      <TabItem Header="翻译">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="10,8" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="原文" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="SourceLanguageCombo" Width="128" DisplayMemberPath="DisplayName"
                          SelectedValuePath="Code" VerticalAlignment="Center"/>
                <Button Content="⇄" ToolTip="交换原文与目标语言" Click="OnSwapLanguages"
                        Style="{StaticResource IconButton}" Margin="8,0"/>
                <TextBlock Text="译文" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="TargetLanguageCombo" Width="128" DisplayMemberPath="DisplayName"
                          SelectedValuePath="Code" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}"
                         Text="Ctrl+Enter 翻译" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="0">
              <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="10,7">
                  <TextBlock Text="原文" Style="{StaticResource SectionLabel}" Margin="0"/>
                </Border>
                <TextBox x:Name="InputText" Style="{StaticResource EditorTextBox}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
              </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="0">
              <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="10,7">
                  <DockPanel>
                    <TextBlock Text="译文" Style="{StaticResource SectionLabel}" Margin="0"
                               VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}"
                               Text="只读" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
                <TextBox x:Name="OutputText" Style="{StaticResource EditorTextBox}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
              </DockPanel>
            </Border>
          </Grid>

          <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <Button Content="清空" Click="OnClear" Style="{StaticResource GhostButton}" Margin="0,0,4,0"/>
              <Button Content="复制" Click="OnCopy" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/>
              <Button Content="交换" Click="OnSwap" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
              <Button x:Name="TranslateButton" Content="翻译" Click="OnTranslate"
                      Style="{StaticResource PrimaryButton}" IsDefault="True"/>
            </StackPanel>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- 设置 -->
      <TabItem Header="设置">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="10,8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="翻译引擎" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"
                         VerticalAlignment="Center"/>
              <ComboBox x:Name="EngineCombo" Width="220"
                        SelectionChanged="OnEngineSelectionChanged"/>
              <TextBlock Style="{StaticResource MutedText}" Margin="12,0,0,0"
                         VerticalAlignment="Center"
                         Text="在下方配置 API 后，启用的引擎会出现在此列表"/>
            </StackPanel>
          </Border>

          <TabControl Grid.Row="1">
            <TabItem Header="百度翻译">
              <Border Style="{StaticResource PanelBorder}" Margin="0,10,0,0" Padding="14">
                <StackPanel>
                  <TextBlock Text="API 密钥" Style="{StaticResource SectionLabel}"/>
                  <TextBlock Text="App ID" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="BaiduAppIdBox" Margin="0,0,0,10"/>
                  <TextBlock Text="密钥 (Secret Key)" Style="{StaticResource FieldLabel}"/>
                  <PasswordBox x:Name="BaiduSecretBox"/>
                  <TextBlock Margin="0,10,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                             Text="在 fanyi-api.baidu.com 注册通用翻译 API，获取 App ID 与密钥。"/>
                </StackPanel>
              </Border>
            </TabItem>

            <TabItem Header="AI 翻译">
              <DockPanel Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                  <Button Content="添加" Click="OnAddProvider" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                  <Button Content="删除" Click="OnRemoveProvider" Style="{StaticResource GhostButton}" Margin="0,0,6,0"/>
                  <Button Content="复制" Click="OnDuplicateProvider" Style="{StaticResource GhostButton}"/>
                </StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <ListBox x:Name="ProvidersList" Grid.Column="0"
                           DisplayMemberPath="Name"
                           SelectionChanged="OnProviderSelectionChanged"/>
                  <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <StackPanel x:Name="ProviderEditor" IsEnabled="False">
                        <CheckBox x:Name="ProviderEnabledBox" Content="启用此配置（出现在翻译引擎列表）"
                                  IsChecked="True"/>
                        <TextBlock Text="显示名称" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ProviderNameBox" Margin="0,0,0,10"/>
                        <TextBlock Text="API Key" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="ProviderApiKeyBox" Margin="0,0,0,10"/>
                        <TextBlock Text="Base URL" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ProviderBaseUrlBox" Margin="0,0,0,10"/>
                        <TextBlock Text="模型" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ProviderModelBox" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <TextBlock Text="Temperature" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ProviderTemperatureBox"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Text="Max Tokens" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ProviderMaxTokensBox"/>
                          </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   Text="兼容 OpenAI 协议（OpenAI、DeepSeek、智谱、Ollama 等）。Base URL 填端点根路径；仅域名时自动补 /v1/。"/>
                      </StackPanel>
                    </ScrollViewer>
                  </Border>
                </Grid>
              </DockPanel>
            </TabItem>

            <TabItem Header="通用">
              <Border Style="{StaticResource PanelBorder}" Margin="0,10,0,0" Padding="14">
                <StackPanel>
                  <CheckBox x:Name="RunAtStartupBox" Content="开机自动启动（登录后静默到托盘）"/>
                  <CheckBox x:Name="RememberTranslatorBox" Content="记住上次使用的翻译引擎"/>
                  <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                             Text="全局快捷键：Alt+Space（显示 / 隐藏窗口）"/>
                </StackPanel>
              </Border>
            </TabItem>
          </TabControl>

          <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                  Margin="0,12,0,0" Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="保存设置" Click="OnSaveSettings"
                      Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- 关于 -->
      <TabItem Header="关于">
        <Border Style="{StaticResource PanelBorder}" Margin="0,12,0,0" Padding="24" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="熔岩翻译助手" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="v1.0.0" Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
            <TextBlock Text="基于 .NET 10 WPF" Margin="0,0,0,6"/>
            <TextBlock Text="支持百度翻译 API 与 OpenAI 兼容 AI 翻译" Margin="0,0,0,16"/>
            <TextBlock Style="{StaticResource MutedText}" Text="快捷键：Alt+Space（显示 / 隐藏窗口）"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                       Text="关闭窗口后程序会继续在系统托盘运行"/>
          </StackPanel>
        </Border>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
